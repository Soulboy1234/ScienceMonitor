{
  "version": "0.5",
  "description": "Preferred hierarchical tag wordlist for ScienceMonitor. The runtime should normalize outputs toward these canonical names, but it remains open-vocabulary when no suitable preferred tag exists.",
  "categories": [
    {
      "id": "research_object",
      "label": "研究对象",
      "order": 1
    },
    {
      "id": "event_driver",
      "label": "事件 / 驱动",
      "order": 2
    },
    {
      "id": "index_control",
      "label": "指数 / 控制量",
      "order": 3
    },
    {
      "id": "instrument_data",
      "label": "仪器 / 数据",
      "order": 4
    },
    {
      "id": "model_method",
      "label": "模型 / 方法",
      "order": 5
    },
    {
      "id": "result_feature",
      "label": "结果特征",
      "order": 6
    },
    {
      "id": "application_impact",
      "label": "应用 / 影响",
      "order": 7
    },
    {
      "id": "status",
      "label": "状态标签",
      "order": 8
    }
  ],
  "tag_rules": {
    "style": "Prefer concise noun-like hierarchical tags. Reuse this preferred wordlist first, but allow reasonable new tags when the list does not cover the paper.",
    "open_vocabulary": true,
    "default_max_tags": 14,
    "candidate_log_path": "data/tag_candidates.json",
    "drop_patterns": [
      "^(研究星球/地球|地球|earth|terrestrial)$"
    ],
    "unknown_tag_policy": {
      "max_length": 24,
      "max_levels": 4,
      "reject_patterns": [
        "(?i)^(todo|tbd|placeholder|oops)$",
        "^[0-9]+$"
      ]
    }
  },
  "suppression_rules": [
    {
